# ReleasePilot Backend — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Port the Express server listens on (Render sets this automatically)
PORT=3001

# Set to the exact URL of your Vercel frontend deployment (no trailing slash).
# This restricts CORS to only that origin in production.
# Leave unset (or empty) for local development — all origins are allowed.
FRONTEND_URL=https://your-releasepilot.vercel.app

# Node environment — set to "production" on Render automatically
NODE_ENV=development
